# GACS Research Pipeline - Environment Variables
# Copy this file to .env and fill in your values

# Core
ANTHROPIC_API_KEY=sk-ant-your-key-here
GACS_QUICK_TEST=0
GACS_LOG_LEVEL=INFO

# Google OAuth (download client_secrets.json from Google Cloud Console)
# See README.md for setup instructions

# Webhook security (Task 1.2)
DID_WEBHOOK_SECRET=your_hmac_secret_here_min_32_chars

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://gacs_user@staging.gacs.internal:5432/gacs_staging
WEBHOOK_PORT=3000

# Application
NODE_ENV=development
LOG_LEVEL=info

# Smart DID Incremental Sync (Task 1.3)
SMART_DID_API_BASE_URL=https://smart-did.example.com
SMART_DID_API_TOKEN=your_smart_did_api_token_here
SMART_DID_VIDEO_RECORDS_PATH=/api/video-records
DID_SYNC_ENABLED=false
DID_SYNC_QUEUE_NAME=did-incremental-sync
DID_SYNC_INTERVAL_MS=900000
DID_SYNC_BATCH_SIZE=500
DID_SYNC_LOOKBACK_SECONDS=120
DID_SYNC_REQUEST_TIMEOUT_MS=10000
DID_SYNC_MAX_PAGES=20
DID_SYNC_LOCK_TTL_MS=840000
DID_SYNC_JOB_ATTEMPTS=3
DID_SYNC_JOB_BACKOFF_MS=30000
DID_SYNC_WORKER_CONCURRENCY=1
SYNC_WORKER_ENABLED=false

# ML Feature Store (Sprint 1)
FEATURE_COMPUTE_INTERVAL_MS=86400000
INFERENCE_INTERVAL_MS=86400000
FEATURE_WORKER_ENABLED=false
INFERENCE_WORKER_ENABLED=false
FEATURE_COMPUTATION_QUEUE_NAME=feature-computation
INFERENCE_QUEUE_NAME=ml-inference
MODEL_PATH=data/models/ml
TRAINING_DATA_PATH=data/training_data.csv

# Sprint 2: API Security
INFERENCE_API_KEY=your-api-key-here-change-in-production
